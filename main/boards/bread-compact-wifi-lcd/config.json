{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-st7789-240x240",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-st7735-80x160",
            "sdkconfig_append": [
                "CONFIG_LCD_CUSTOM=y",
                "CONFIG_BREAD_COMPACT_WIFI_LCD_ST7735_80X160=y"
            ]
        }
    ]
}
